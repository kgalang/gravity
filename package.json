{
  "name": "gravity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#dist\"",
    "lint:repo": "node scripts/lint-repo.mjs",
    "test:invariants": "node scripts/test-invariants.mjs",
    "check": "npm run typecheck && npm run test:unit && npm run lint:md && npm run lint:repo && npm run test:invariants",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "bash scripts/db-migrate.sh",
    "db:rollback": "bash scripts/db-rollback.sh",
    "db:status": "bash scripts/db-status.sh",
    "db:new": "dbmate --migrations-dir db/migrations --schema-file schema.sql --no-dump-schema new",
    "db:apply": "bash scripts/db-apply.sh"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.16.0",
    "dbmate": "^2.30.0",
    "markdownlint-cli2": "^0.18.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@slack/socket-mode": "2.0.0",
    "@slack/web-api": "7.0.0",
    "kysely": "^0.28.11",
    "pg": "^8.18.0"
  }
}
